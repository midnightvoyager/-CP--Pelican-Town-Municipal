{
    "Format": "2.9.0",
    "ConfigSchema": {
        "AutoRecolor": {
            "Description": "Exterior recolor. Defaults to automatic, based on your installed mods.",
            "AllowValues": "Automatic, Vanilla, Earthy, Starblue, Vibrant",
            "Default": "Automatic",
            "AllowBlank": false
        },
        "AutoRecolorMap": {
            "Description": "World map recolor. Defaults to automatic, based on your installed mods.",
            "AllowValues": "Automatic, Vanilla, Earthy, Starblue, Vibrant, VibrantGreen, OvergrownVintage",
            "Default": "Automatic",
            "AllowBlank": false
        },
        "PerfectionScoreNpc": {
            "Description": "Exclude or Include Bill from perfection score.",
            "AllowValues": "Exclude, Include",
            "Default": "Exclude",
            "AllowBlank": false
        },
        "PerfectionScoreObjects": {
            "Description": "Exclude or Include Mana Blooms from perfection score.",
            "AllowValues": "Exclude, Include",
            "Default": "Exclude",
            "AllowBlank": false
        },
        "FireSafety": {
            "Description": "Add fire extinguishers to houses in Pelican Town after the Municipal Building opens.",
            "AllowValues": "true, false",
            "Default": "true",
            "AllowBlank": false
        },
        "MarlonPortrait": {
            "Description": "A portrait for Marlon that has expressions. Works with DSV! (Unneeded if you have one already, like from Ranch Expansion)",
            "AllowValues": "true, false",
            "Default": "true",
            "AllowBlank": false
        },
        "WizardPortrait": {
            "Description": "A portrait for the Wizard that has 9 frames of expressions and RR's sprite with a sleep frame. Works with DSV! (Unneeded if you have one already, like Romanceable Rasmodius or SVE)",
            "AllowValues": "true, false",
            "Default": "true",
            "AllowBlank": false
        },
        "RivalHearts": {
            "Description": "Rival hearts for Bill and Rasmodius. I do not recommend changing this on a game you've played this mod in for a while! This will be disabled despite settings if you have RRRR enabled or a mod to make Rasmodius a woman.",
            "AllowValues": "Enable, Disable",
            "Default": "Enable",
            "AllowBlank": false
        },
        "WizardSprite": {
            "Description": "What sprite do you use for the wizard? For placement of the sleep frame only in Rival Hearts. Not needed if you use my Wizard Portrait option.",
            "AllowValues": "Vanilla, VanillaNiko, SVE, Other",
            "Default": "Vanilla",
            "AllowBlank": false
        },
        "ManaBloomSeeds": {
            "Description": "What style of seed bag do you want for the Mana Bloom?",
            "AllowValues": "ManaBloomVanilla, ManaBloomVanillaSeasonal, ManaBloomVT, ManaBloomVTSeasonal, ManaBloomVTSunny, ManaBloomVTSunnySeasonal",
            "Default": "ManaBloomVanilla",
            "AllowBlank": false
        },
        "MailVersion": {
            "Description": "What style of envelope do you want for Mailbox Menu?",
            "AllowValues": "Aedenthorn, Zilchaz",
            "Default": "Zilchaz",
            "AllowBlank": false
        }
    },
