        //Bill's Daily Dialog Randomization Section, this is Axell's fault (Thanks Axell for the method!)
        {
            "LogName": "Bill's 0-4 Heart Dialogue",
            "Action": "EditData",
            "Update": "OnLocationChange",
            "Target": "Characters/Dialogue/{{ModID}}_SheriffBill",
            "Entries": {
                "{{WeekDay}}": "{{i18n:MV.Municipal.Dialogue.Daily.{{Random:{{Range: 1, 16}}}}}}"
            },
            "When": {
                "HasFlag: |contains=SheriffBill_OverrideSeenToday": false
            }
        },
        {
            "LogName": "Bill's 5-10 Heart Dialogue",
            "Action": "EditData",
            "Update": "OnLocationChange",
            "Target": "Characters/Dialogue/{{ModID}}_SheriffBill",
            "Entries": {
                "{{WeekDay}}": "{{i18n:MV.Municipal.Dialogue.Daily.{{Random:{{Range: 1, 34}}}}}}#$action AddMail Current SheriffBill_OverrideSeenToday received"
            },
            "When": {
                "HasFlag: |contains=SheriffBill_OverrideSeenToday": false,
                "Hearts:{{ModID}}_SheriffBill": "{{Range: 5, 10}}"
            }
        },
        {
            "LogName": "Bill's 10 Heart Post-Event Dialogue",
            "Action": "EditData",
            "Update": "OnLocationChange",
            "Target": "Characters/Dialogue/{{ModID}}_SheriffBill",
            "Entries": {
                "{{WeekDay}}": "{{i18n:MV.Municipal.Dialogue.Daily.{{Random:{{Range: 1, 41}}}}}}#$action AddMail Current SheriffBill_OverrideSeenToday received"
            },
            "When": {
                "HasFlag: |contains=SheriffBill_OverrideSeenToday": false,
                "HasFlag: hostPlayer |contains={{ModID}}_Bill10H": true
            }
        },
        {
            "LogName": "Bill's Seasonal Dialogue Override",
